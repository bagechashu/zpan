# ZPan Environment Variables Configuration
# =========================================
# Copy this file to .env and fill in your actual values
# Then load it before running zpan:
#   source .env
#   ./build/bin/zpan server

# 🔐 JWT Configuration
# ====================
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=your-generated-secret-key-at-least-32-chars

# 🔐 LDAP Configuration (optional)
# ================================
# Only required if ldap.enabled is set to true in config.yml
# The password for the LDAP bind DN
LDAP_BIND_PASSWORD=your-ldap-bind-password

# 📧 Email Configuration (optional)
# =================================
# If using email notifications for password reset and account activation
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@example.com

# 📊 Database Configuration (optional)
# ====================================
# Only override if not using SQLite in config.yml
# DATABASE_DSN=mysql://user:password@tcp(127.0.0.1:3306)/zpan?parseTime=true

# 🌐 Server Configuration (optional)
# ==================================
PORT=8222
LOGLEVEL=info

# ⚠️ SECURITY NOTES
# ================
# 1. NEVER commit .env file to git - it contains secrets!
# 2. In production, use a secrets management system (AWS Secrets Manager, Vault, etc.)
# 3. Make .env readable only by the zpan user: chmod 600 .env
# 4. JWT_SECRET and LDAP_BIND_PASSWORD must be kept secure and rotated regularly
